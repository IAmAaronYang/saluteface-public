{
  "name": "telemetry_event",
  "version": 1,
  "fields": {
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}$",
      "required": true
    },
    "level": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"],
      "required": true
    },
    "count": {
      "type": "integer",
      "min": 0,
      "max": 100000,
      "required": true
    },
    "ratio": {
      "type": "number",
      "min": 0,
      "max": 1
    },
