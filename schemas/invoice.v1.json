{
  "name": "invoice",
  "version": 1,
  "fields": {
    "id": {
      "type": "string",
      "pattern": "^INV-[0-9]{6}$",
      "required": true
    },
    "total": {
      "type": "number",
      "min": 0,
      "max": 1000000000,
      "required": true
    },
    "currency": {
      "type": "string",
      "enum": ["USD", "EUR", "GBP"],
      "required": true
    },
    "lines": {
      "type": "array",
      "min_items": 1,
      "max_items": 500,
      "items": { "type": "object" }
    },
