# SchemaPilot environment configuration
# Copy to `.env` and adjust as needed. SchemaPilot itself is dependency-free
# and reads these only when present; unset values fall back to built-in
# defaults.

# Deterministic seed used by `schemapilot fuzz` and `schemapilot report`
# when no --seed flag is supplied.
SCHEMAPILOT_SEED=0

# Default number of valid payloads generated per run.
SCHEMAPILOT_VALID_COUNT=3

# Default number of adversarial payloads generated per contract field.
SCHEMAPILOT_ADVERSARIAL_PER_FIELD=3

# Acceptance threshold (0.0-1.0) for the compatibility matrix verdicts.
